xt><text x="1077" y="626" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#15803D">// one reason to change each</tspan></text><rect x="50" y="824" width="480" height="380" rx="20" fill="#DCFCE7"/><circle cx="95" cy="874" r="30" fill="#15803D"/><text x="95" y="885" class="s" font-size="32" font-weight="800" fill="#fff" text-anchor="middle">O</text><rect x="140" y="844" width="370" height="60" rx="30.0" fill="#15803D"/><text x="325.0" y="883.1" class="s" font-size="26" font-weight="800" fill="#fff" text-anchor="middle">Open / Closed</text><circle cx="75" cy="936" r="4" fill="#111827"/><text x="90" y="942" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">Open for extension, closed for</text><text x="90" y="967" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">modification.</text><circle cx="75" cy="994" r="4" fill="#111827"/><text x="90" y="1000" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">Add behavior with new classes</text><text x="90" y="1025" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">instead of editing tested code.</text><circle cx="75" cy="1052" r="4" fill="#111827"/><text x="90" y="1058" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">Use interfaces and polymorphism.</text><rect x="75" y="1142" width="430" height="40" rx="20" fill="#fff" stroke="#15803D" stroke-width="2"/><text x="290" y="1168" class="s" font-size="18" font-weight="800" fill="#15803D" text-anchor="middle">Remember: Extend, don't edit</text><rect x="550" y="824" width="1000" height="380" rx="20" fill="#F8FAFC" stroke="#CBD5E1" stroke-width="2"/><rect x="565" y="838" width="480" height="352" rx="14" fill="#FEF2F2" stroke="#DC2626" stroke-width="2"/><rect x="580" y="850" width="300" height="40" rx="20.0" fill="#B91C1C"/><text x="730.0" y="875.95" class="s" font-size="17" font-weight="800" fill="#fff" text-anchor="middle">Before: breaks the principle</text><text x="582" y="922" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#7C3AED" font-weight="700">double</tspan> area(<tspan fill="#1D4ED8">Shape</tspan> s) {</text><text x="582" y="949" class="m" xml:space="preserve" font-size="16" fill="#111827">  <tspan fill="#7C3AED" font-weight="700">if</tspan> (s <tspan fill="#7C3AED" font-weight="700">instanceof</tspan> <tspan fill="#1D4ED8">Circle</tspan> c)</text><text x="582" y="976" class="m" xml:space="preserve" font-size="16" fill="#111827">    <tspan fill="#7C3AED" font-weight="700">return</tspan> <tspan fill="#1D4ED8">Math</tspan>.<tspan fill="#1D4ED8">PI</tspan> * c.r * c.r;</text><text x="582" y="1003" class="m" xml:space="preserve" font-size="16" fill="#111827">  <tspan fill="#7C3AED" font-weight="700">else</tspan> <tspan fill="#7C3AED" font-weight="700">if</tspan> (s <tspan fill="#7C3AED" font-weight="700">instanceof</tspan> <tspan fill="#1D4ED8">Square</tspan> q)</text><text x="582" y="1030" class="m" xml:space="preserve" font-size="16" fill="#111827">    <tspan fill="#7C3AED" font-weight="700">return</tspan> q.side * q.side;</text><text x="582" y="1057" class="m" xml:space="preserve" font-size="16" fill="#111827">  <tspan fill="#15803D">// new shape = edit this method</tspan></text><text x="582" y="1084" class="m" xml:space="preserve" font-size="16" fill="#111827">}</text><rect x="1060" y="838" width="475" height="352" rx="14" fill="#F0FDF4" stroke="#16A34A" stroke-width="2"/><rect x="1075" y="850" width="300" height="40" rx="20.0" fill="#15803D"/><text x="1225.0" y="875.95" class="s" font-size="17" font-weight="800" fill="#fff" text-anchor="middle">After: follows the principle</text><text x="1077" y="922" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#7C3AED" font-weight="700">interface</tspan> <tspan fill="#1D4ED8">Shape</tspan> { <tspan fill="#7C3AED" font-weight="700">double</tspan> area(); }</text><text x="1077" y="949" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#7C3AED" font-weight="700">class</tspan> <tspan fill="#1D4ED8">Circle</tspan> <tspan fill="#7C3AED" font-weight="700">implements</tspan> <tspan fill="#1D4ED8">Shape</tspan> {</text><text x="1077" y="976" class="m" xml:space="preserve" font-size="16" fill="#111827">  <tspan fill="#7C3AED" font-weight="700">public</tspan> <tspan fill="#7C3AED" font-weight="700">double</tspan> area() {</text><text x="1077" y="1003" class="m" xml:space="preserve" font-size="16" fill="#111827">    <tspan fill="#7C3AED" font-weight="700">return</tspan> <tspan fill="#1D4ED8">Math</tspan>.<tspan fill="#1D4ED8">PI</tspan> * r * r;</text><text x="1077" y="1030" class="m" xml:space="preserve" font-size="16" fill="#111827">  }</text><text x="1077" y="1057" class="m" xml:space="preserve" font-size="16" fill="#111827">}</text><text x="1077" y="1084" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#15803D">// add Triangle, touch nothing old</tspan></text><rect x="50" y="1228" width="480" height="380" rx="20" fill="#FEF3C7"/><circle cx="95" cy="1278" r="30" fill="#B45309"/><text x="95" y="1289" class="s" font-size="32" font-weight="800" fill="#fff" text-anchor="middle">L</text><rect x="140" y="1248" width="370" height="60" rx="30.0" fill="#B45309"/><text x="325.0" y="1287.1" class="s" font-size="26" font-weight="800" fill="#fff" text-anchor="middle">Liskov Substitution</text><circle cx="75" cy="1340" r="4" fill="#111827"/><text x="90" y="1346" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">Subtypes must be usable wherever the</text><text x="90" y="1371" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">parent type is expected.</text><circle cx="75" cy="1398" r="4" fill="#111827"/><text x="90" y="1404" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">A subclass keeps the parent's</text><text x="90" y="1429" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">contract.</text><circle cx="75" cy="1456" r="4" fill="#111827"/><text x="90" y="1462" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">No surprises: don't throw or weaken</text><text x="90" y="1487" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">behavior.</text><rect x="75" y="1546" width="430" height="40" rx="20" fill="#fff" stroke="#B45309" stroke-width="2"/><text x="290" y="1572" class="s" font-size="18" font-weight="800" fill="#B45309" text-anchor="middle">Remember: Subtypes keep promises</text><rect x="550" y="1228" width="1000" height="380" rx="20" fill="#F8FAFC" stroke="#CBD5E1" stroke-width="2"/><rect x="565" y="1242" width="480" height="352" rx="14" fill="#FEF2F2" stroke="#DC2626" stroke-width="2"/><rect x="580" y="1254" width="300" height="40" rx="20.0" fill="#B91C1C"/><text x="730.0" y="1279.95" class="s" font-size="17" font-weight="800" fill="#fff" text-anchor="middle">Before: breaks the principle</text><text x="582" y="1326" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#7C3AED" font-weight="700">class</tspan> <tspan fill="#1D4ED8">Bird</tspan> { <tspan fill="#7C3AED" font-weight="700">void</tspan> fly() { } }</text><text x="582" y="1353" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#7C3AED" font-weight="700">class</tspan> <tspan fill="#1D4ED8">Penguin</tspan> <tspan fill="#7C3AED" font-weight="700">extends</tspan> <tspan fill="#1D4ED8">Bird</tspan> {</text><text x="582" y="1380" class="m" xml:space="preserve" font-size="16" fill="#111827">  <tspan fill="#B45309">@Override</tspan> <tspan fill="#7C3AED" font-weight="700">void</tspan> fly() {</text><text x="582" y="1407" class="m" xml:space="preserve" font-size="16" fill="#111827">    <tspan fill="#7C3AED" font-weight="700">throw</tspan> <tspan fill="#7C3AED" font-weight="700">new</tspan> <tspan fill="#1D4ED8">UnsupportedOperationException</tspan>();</text><text x="582" y="1434" class="m" xml:space="preserve" font-size="16" fill="#111827">  }</text><text x="582" y="1461" class="m" xml:space="preserve" font-size="16" fill="#111827">}</text><text x="582" y="1488" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#15803D">// Penguin breaks Bird's contract</tspan></text><rect x="1060" y="1242" width="475" height="352" rx="14" fill="#F0FDF4" stroke="#16A34A" stroke-width="2"/><rect x="1075" y="1254" width="300" height="40" rx="20.0" fill="#15803D"/><text x="1225.0" y="1279.95" class="s" font-size="17" font-weight="800" fill="#fff" text-anchor="middle">After: follows the principle</text><text x="1077" y="1326" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#7C3AED" font-weight="700">interface</tspan> <tspan fill="#1D4ED8">Bird</tspan> { <tspan fill="#7C3AED" font-weight="700">void</tspan> eat(); }</text><text x="1077" y="1353" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#7C3AED" font-weight="700">interface</tspan> <tspan fill="#1D4ED8">Flyer</tspan> { <tspan fill="#7C3AED" font-weight="700">void</tspan> fly(); }</text><text x="1077" y="1380" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#7C3AED" font-weight="700">class</tspan> <tspan fill="#1D4ED8">Sparrow</tspan> <tspan fill="#7C3AED" font-weight="700">implements</tspan> <tspan fill="#1D4ED8">Bird</tspan>, <tspan fill="#1D4ED8">Flyer</tspan> { }</text><text x="1077" y="1407" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#7C3AED" font-weight="700">class</tspan> <tspan fill="#1D4ED8">Penguin</tspan> <tspan fill="#7C3AED" font-weight="700">implements</tspan> <tspan fill="#1D4ED8">Bird</tspan> { }</text><text x="1077" y="1434" class="m" xml:space="preserve" font-size="16" fill="#111827"></text><text x="1077" y="1461" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#15803D">// every subtype works as its parent</tspan></text><rect x="50" y="1632" width="480" height="380" rx="20" fill="#FCE7F3"/><circle cx="95" cy="1682" r="30" fill="#BE185D"/><text x="95" y="1693" class="s" font-size="32" font-weight="800" fill="#fff" text-anchor="middle">I</text><rect x="140" y="1652" width="370" height="60" rx="30.0" fill="#BE185D"/><text x="325.0" y="1691.1" class="s" font-size="26" font-weight="800" fill="#fff" text-anchor="middle">Interface Segregation</text><circle cx="75" cy="1744" r="4" fill="#111827"/><text x="90" y="1750" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">Prefer small, focused interfaces.</text><circle cx="75" cy="1777" r="4" fill="#111827"/><text x="90" y="1783" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">No class is forced to implement</text><text x="90" y="1808" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">methods it does not use.</text><circle cx="75" cy="1835" r="4" fill="#111827"/><text x="90" y="1841" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">Many specific interfaces beat one</text><text x="90" y="1866" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">big one.</text><rect x="75" y="1950" width="430" height="40" rx="20" fill="#fff" stroke="#BE185D" stroke-width="2"/><text x="290" y="1976" class="s" font-size="18" font-weight="800" fill="#BE185D" text-anchor="middle">Remember: Small interfaces</text><rect x="550" y="1632" width="1000" height="380" rx="20" fill="#F8FAFC" stroke="#CBD5E1" stroke-width="2"/><rect x="565" y="1646" width="480" height="352" rx="14" fill="#FEF2F2" stroke="#DC2626" stroke-width="2"/><rect x="580" y="1658" width="300" height="40" rx="20.0" fill="#B91C1C"/><text x="730.0" y="1683.95" class="s" font-size="17" font-weight="800" fill="#fff" text-anchor="middle">Before: breaks the principle</text><text x="582" y="1730" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#7C3AED" font-weight="700">interface</tspan> <tspan fill="#1D4ED8">Worker</tspan> {</text><text x="582" y="1757" class="m" xml:space="preserve" font-size="16" fill="#111827">  <tspan fill="#7C3AED" font-weight="700">void</tspan> work(); <tspan fill="#7C3AED" font-weight="700">void</tspan> eat(); <tspan fill="#7C3AED" font-weight="700">void</tspan> sleep();</text><text x="582" y="1784" class="m" xml:space="preserve" font-size="16" fill="#111827">}</text><text x="582" y="1811" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#7C3AED" font-weight="700">class</tspan> <tspan fill="#1D4ED8">Robot</tspan> <tspan fill="#7C3AED" font-weight="700">implements</tspan> <tspan fill="#1D4ED8">Worker</tspan> {</text><text x="582" y="1838" class="m" xml:space="preserve" font-size="16" fill="#111827">  <tspan fill="#7C3AED" font-weight="700">public</tspan> <tspan fill="#7C3AED" font-weight="700">void</tspan> eat() { } <tspan fill="#15803D">// forced to implement</tspan></text><text x="582" y="1865" class="m" xml:space="preserve" font-size="16" fill="#111827">}</text><rect x="1060" y="1646" width="475" height="352" rx="14" fill="#F0FDF4" stroke="#16A34A" stroke-width="2"/><rect x="1075" y="1658" width="300" height="40" rx="20.0" fill="#15803D"/><text x="1225.0" y="1683.95" class="s" font-size="17" font-weight="800" fill="#fff" text-anchor="middle">After: follows the principle</text><text x="1077" y="1730" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#7C3AED" font-weight="700">interface</tspan> <tspan fill="#1D4ED8">Workable</tspan> { <tspan fill="#7C3AED" font-weight="700">void</tspan> work(); }</text><text x="1077" y="1757" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#7C3AED" font-weight="700">interface</tspan> <tspan fill="#1D4ED8">Feedable</tspan> { <tspan fill="#7C3AED" font-weight="700">void</tspan> eat(); }</text><text x="1077" y="1784" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#7C3AED" font-weight="700">class</tspan> <tspan fill="#1D4ED8">Robot</tspan> <tspan fill="#7C3AED" font-weight="700">implements</tspan> <tspan fill="#1D4ED8">Workable</tspan> { }</text><text x="1077" y="1811" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#7C3AED" font-weight="700">class</tspan> <tspan fill="#1D4ED8">Human</tspan> <tspan fill="#7C3AED" font-weight="700">implements</tspan> <tspan fill="#1D4ED8">Workable</tspan>, <tspan fill="#1D4ED8">Feedable</tspan> { }</text><text x="1077" y="1838" class="m" xml:space="preserve" font-size="16" fill="#111827"></text><text x="1077" y="1865" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#15803D">// each class takes only what it needs</tspan></text><rect x="50" y="2036" width="480" height="380" rx="20" fill="#EDE9FE"/><circle cx="95" cy="2086" r="30" fill="#6D28D9"/><text x="95" y="2097" class="s" font-size="32" font-weight="800" fill="#fff" text-anchor="middle">D</text><rect x="140" y="2056" width="370" height="60" rx="30.0" fill="#6D28D9"/><text x="325.0" y="2095.1" class="s" font-size="26" font-weight="800" fill="#fff" text-anchor="middle">Dependency Inversion</text><circle cx="75" cy="2148" r="4" fill="#111827"/><text x="90" y="2154" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">Depend on abstractions, not on</text><text x="90" y="2179" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">concrete classes.</text><circle cx="75" cy="2206" r="4" fill="#111827"/><text x="90" y="2212" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">High-level code should not know low-</text><text x="90" y="2237" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">level details.</text><circle cx="75" cy="2264" r="4" fill="#111827"/><text x="90" y="2270" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">Enables dependency injection (e.g.,</text><text x="90" y="2295" class="s" font-size="19" font-weight="400" fill="#1F2937" text-anchor="start">Spring).</text><rect x="75" y="2354" width="430" height="40" rx="20" fill="#fff" stroke="#6D28D9" stroke-width="2"/><text x="290" y="2380" class="s" font-size="18" font-weight="800" fill="#6D28D9" text-anchor="middle">Remember: Depend on abstractions</text><rect x="550" y="2036" width="1000" height="380" rx="20" fill="#F8FAFC" stroke="#CBD5E1" stroke-width="2"/><rect x="565" y="2050" width="480" height="352" rx="14" fill="#FEF2F2" stroke="#DC2626" stroke-width="2"/><rect x="580" y="2062" width="300" height="40" rx="20.0" fill="#B91C1C"/><text x="730.0" y="2087.95" class="s" font-size="17" font-weight="800" fill="#fff" text-anchor="middle">Before: breaks the principle</text><text x="582" y="2134" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#7C3AED" font-weight="700">class</tspan> <tspan fill="#1D4ED8">OrderService</tspan> {</text><text x="582" y="2161" class="m" xml:space="preserve" font-size="16" fill="#111827">  <tspan fill="#7C3AED" font-weight="700">private</tspan> <tspan fill="#1D4ED8">MySqlRepo</tspan> repo = <tspan fill="#7C3AED" font-weight="700">new</tspan> <tspan fill="#1D4ED8">MySqlRepo</tspan>();</text><text x="582" y="2188" class="m" xml:space="preserve" font-size="16" fill="#111827">  <tspan fill="#15803D">// tied to one concrete class</tspan></text><text x="582" y="2215" class="m" xml:space="preserve" font-size="16" fill="#111827">}</text><rect x="1060" y="2050" width="475" height="352" rx="14" fill="#F0FDF4" stroke="#16A34A" stroke-width="2"/><rect x="1075" y="2062" width="300" height="40" rx="20.0" fill="#15803D"/><text x="1225.0" y="2087.95" class="s" font-size="17" font-weight="800" fill="#fff" text-anchor="middle">After: follows the principle</text><text x="1077" y="2134" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#7C3AED" font-weight="700">interface</tspan> <tspan fill="#1D4ED8">OrderRepo</tspan> { <tspan fill="#7C3AED" font-weight="700">void</tspan> save(<tspan fill="#1D4ED8">Order</tspan> o); }</text><text x="1077" y="2161" class="m" xml:space="preserve" font-size="16" fill="#111827"><tspan fill="#7C3AED" font-weight="700">class</tspan> <tspan fill="#1D4ED8">OrderService</tspan> {</text><text x="1077" y="2188" class="m" xml:space="preserve" font-size="16" fill="#111827">  <tspan fill="#7C3AED" font-weight="700">private</tspan> <tspan fill="#7C3AED" font-weight="700">final</tspan> <tspan fill="#1D4ED8">OrderRepo</tspan> repo;</text><text x="1077" y="2215" class="m" xml:space="preserve" font-size="16" fill="#111827">  <tspan fill="#1D4ED8">OrderService</tspan>(<tspan fill="#1D4ED8">OrderRepo</tspan> repo) {</text><text x="1077" y="2242" class="m" xml:space="preserve" font-size="16" fill="#111827">    <tspan fill="#7C3AED" font-weight="700">this</tspan>.repo = repo; <tspan fill="#15803D">// injected</tspan></text><text x="1077" y="2269" class="m" xml:space="preserve" font-size="16" fill="#111827">  }</text><text x="1077" y="2296" class="m" xml:space="preserve" font-size="16" fill="#111827">}</text><rect x="0" y="2440" width="1600" height="130" rx="0" fill="#0F2A4A"/><circle cx="95" cy="2506" r="28" fill="#FACC15"/><rect x="82" y="2532" width="26" height="14" rx="4" fill="#E5E7EB"/><text x="170" y="2518" class="s" font-size="38" font-weight="800" fill="#FACC15" text-anchor="start">In Short:</text><text x="380" y="2500" class="s" font-size="26" font-weight="400" fill="#fff" text-anchor="start">SOLID helps you build flexible, loosely coupled Java code</text><text x="380" y="2536" class="s" font-size="26" font-weight="400" fill="#fff" text-anchor="start">that is easy to extend, test and maintain.</text><text x="1300" y="2524" class="s" font-size="38" font-weight="800"><tspan fill="#9CA3AF">Code</tspan><tspan fill="#FB923C">Trove</tspan></text><metadata><c2pa:manifest></c2pa:manifest></metadata></svg>
